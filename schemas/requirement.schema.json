{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontendRequirementSpecification",
  "description": "Esquema formal para requerimientos UI en docs/backlog/pending.md y changelog.md",
  "type": "object",
  "required": [
    "id",
    "title",
    "priority",
    "impact_type",
    "target_version",
    "references",
    "boundaries",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-UI-[A-Z0-9]+-[0-9]{3,}$",
      "description": "Identificador unico REQ-UI-[DOMINIO]-[NUMERO]"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "priority": {
      "type": "string",
      "enum": ["P1", "P2", "P3"]
    },
    "impact_type": {
      "type": "string",
      "enum": ["MAJOR", "MINOR", "PATCH"]
    },
    "track": {
      "type": "string",
      "enum": ["FULL", "FAST_TRACK"]
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "object",
      "required": ["functional", "technical"],
      "properties": {
        "functional": {
          "type": "string"
        },
        "technical": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tokens_consumed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["artifacts", "restrictions"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "action"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": ["NEW", "MODIFY", "DELETE"]
              }
            }
          }
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "completed"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 5
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
