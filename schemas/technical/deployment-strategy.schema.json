{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontendDeploymentStrategySpecification",
  "description": "Esquema formal para docs/technical/deployment-strategy.md",
  "type": "object",
  "required": [
    "artifact_type",
    "hosting_model",
    "pipeline_diagram_mermaid",
    "public_env_vars",
    "security_headers",
    "rollback_strategy"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "enum": ["deployment-strategy"]
    },
    "hosting_model": {
      "type": "string",
      "enum": ["static-cdn", "ssr-node", "edge-serverless", "hybrid"]
    },
    "branching_model": {
      "type": "string",
      "enum": ["trunk-based", "github-flow", "gitflow"]
    },
    "environments": {
      "type": "object",
      "properties": {
        "preview": {
          "type": "object",
          "properties": {
            "trigger": { "type": "string" }
          }
        },
        "staging": {
          "type": "object",
          "properties": {
            "trigger": { "type": "string" },
            "github_environment": { "type": "string" }
          }
        },
        "production": {
          "type": "object",
          "properties": {
            "trigger": { "type": "string" },
            "github_environment": { "type": "string" }
          }
        }
      }
    },
    "pipeline_diagram_mermaid": {
      "type": "string",
      "minLength": 10
    },
    "public_env_vars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose", "is_secret"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "purpose": {
            "type": "string",
            "minLength": 3
          },
          "is_secret": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "ci_source": {
            "type": "string",
            "enum": ["github_var", "platform_env", "runtime_env"]
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["local", "preview", "staging", "production"]
            }
          }
        }
      }
    },
    "security_headers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "cache_policy": {
      "type": "string"
    },
    "rollback_strategy": {
      "type": "string",
      "minLength": 5
    }
  }
}
