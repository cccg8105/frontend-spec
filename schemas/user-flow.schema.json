{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserFlowSpecification",
  "description": "Esquema formal para flujos UX en docs/functional/user-flows/UF-*.md",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "actor",
    "route",
    "status",
    "flow_diagram_mermaid",
    "ui_states",
    "accessibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^UF-[A-Z0-9]+-[0-9]{3,}$",
      "description": "Identificador unico UF-[DOMINIO]-[NUMERO]"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "actor": {
      "type": "string",
      "minLength": 2
    },
    "route": {
      "type": "string",
      "pattern": "^/"
    },
    "status": {
      "type": "string",
      "enum": ["Borrador", "Activo", "As-Is (Brownfield)", "Deprecado"]
    },
    "auth_required": {
      "type": "boolean"
    },
    "fsm_required": {
      "type": "boolean"
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["mobile", "tablet", "desktop"]
      }
    },
    "flow_diagram_mermaid": {
      "type": "string",
      "minLength": 10
    },
    "user_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "validation": {
            "type": "string"
          }
        }
      }
    },
    "visual_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element", "condition", "behavior"],
        "properties": {
          "element": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "behavior": {
            "type": "string"
          }
        }
      }
    },
    "ui_states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "trigger", "feedback"],
        "properties": {
          "state": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "feedback": {
            "type": "string"
          },
          "recovery": {
            "type": "string"
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["focus_management", "semantic_roles"],
      "properties": {
        "focus_management": {
          "type": "string",
          "minLength": 5
        },
        "semantic_roles": {
          "type": "string",
          "minLength": 5
        },
        "responsive_rules": {
          "type": "string"
        }
      }
    }
  }
}
