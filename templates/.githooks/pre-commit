#!/usr/bin/env bash
# ==============================================================================
# frontend-spec v1.2.0 - Pre-commit Hook (Integridad Documental & Anti-Fantasmas)
# ==============================================================================

# FRONTEND-SPEC:START
echo "[frontend-spec] Validando integridad de especificaciones y trazabilidad del commit (--staged)..."

# 1. Resolver cómo invocar frontend-spec de forma portable
if command -v frontend-spec >/dev/null 2>&1; then
    frontend-spec check --staged
    CHECK_STATUS=$?
elif command -v fspec >/dev/null 2>&1; then
    fspec check --staged
    CHECK_STATUS=$?
elif [ -f "./cli/main.py" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 ./cli/main.py check --staged
    else
        python ./cli/main.py check --staged
    fi
    CHECK_STATUS=$?
elif command -v uvx >/dev/null 2>&1; then
    uvx frontend-spec check --staged
    CHECK_STATUS=$?
else
    echo ""
    echo "[frontend-spec] No se encontró el comando 'frontend-spec' en PATH."
    echo "   Instálalo con: uv tool install frontend-spec (o pipx install frontend-spec)"
    echo "   En caso de emergencia operativa, puedes omitir este hook con: git commit --no-verify"
    echo ""
    exit 1
fi

if [ $CHECK_STATUS -ne 0 ]; then
    echo ""
    echo "[frontend-spec] Commit bloqueado por verificación de integridad o trazabilidad."
    echo "   - Si hay enlaces o esquemas rotos en docs/, corrígelos o ejecuta 'frontend-spec sync'."
    echo "   - Si modificaste código fuente sin trazabilidad, registra primero el requerimiento en"
    echo "     docs/backlog/pending.md (ej. 'frontend-spec req:new \"Fix...\" --impact PATCH')."
    echo "   - Escape solo para emergencias críticas en producción: git commit --no-verify"
    echo ""
    exit 1
fi

echo "[frontend-spec] Validación y trazabilidad superadas con éxito."
# FRONTEND-SPEC:END
exit 0
